# Everyone can read; only admins change. Macros are shared system-wide so ad-hoc searches in
# Search & Reporting can use them too (e.g. `lab_failed_logon_fields`).
[]
access = read : [ * ], write : [ admin ]

[macros]
export = system

# Zone lookup (lab_zones) is usable from any app.
[transforms]
export = system

[lookups]
export = system

[savedsearches]
export = none
